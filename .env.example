# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo servidor (firma URLs de Storage). Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxx

# Supabase → Connect. Sin "?pgbouncer=true" (es solo para Prisma).
# App: transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Migraciones (drizzle-kit): session pooler (puerto 5432)
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# URL pública de la app (enlaces en los emails)
APP_URL=http://localhost:3000

# Resend (emails). Sin RESEND_API_KEY los emails solo se muestran en consola.
RESEND_API_KEY=
# Dominio verificado en Resend. onboarding@resend.dev solo entrega a tu propio email.
EMAIL_FROM="Calis Cup <onboarding@resend.dev>"

# Emails (separados por coma) que obtienen rol admin al completar su perfil
ADMIN_EMAILS=
